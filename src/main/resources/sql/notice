CREATE table notice_board (
    notice_number NUMBER GENERATED ALWAYS AS IDENTITY,
    notice_name VARCHAR2(15) DEFAULT '관리자',
    notice_title VARCHAR2(1000) NOT NULL,
    notice_content CLOB,
    notice_passwd VARCHAR2(18) NOT NULL,
    notice_readcnt NUMBER DEFAULT 0 NOT NULL,
    notice_DATE DATE DEFAULT SYSDATE,
    CONSTRAINT notice_number_pk PRIMARY KEY(notice_number)
);

